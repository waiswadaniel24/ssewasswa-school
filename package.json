{
  "name": "ssewasswa-school-v10-isolated",
  "version": "10.0.0",
  "description": "Commercial School ERP",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "npm run dev:vite",
    "dev:desktop": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "lint": "eslint \"src/**/*.js\" \"src/**/*.jsx\" \"electron/main.js\"",
    "format": "prettier --write \"src/**\" \"electron/**\" package.json",
    "ci": "npm run lint && npm run build",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "electron-store": "^8.2.0",
    "express": "^4.18.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "mammoth": "^1.12.3",
    "nodemailer": "^6.9.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.20.1",
    "recharts": "^2.12.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^5.0.5",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.32.0",
    "javascript-obfuscator": "^4.1.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "build": {
    "appId": "com.ssewasswa.school",
    "productName": "Ssewasswa School ERP V10",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/*/{README.md,README,readme.md,readme,test,tests,__tests__}",
      "!**/node_modules/**/{.github,.bin,.travis.yml}",
      "!**/node_modules/**/{Makefile,CMakeLists.txt}",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.ts",
      "!**/node_modules/**/*.flow",
      "!**/node_modules/**/*.coffee",
      "!**/node_modules/**/LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "compression": "maximum",
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
