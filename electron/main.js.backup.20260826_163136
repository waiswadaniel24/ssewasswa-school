ipcMain.handle('backfill-paycodes', async () => {
  try {
    const students = db.exec("SELECT id FROM students WHERE status='Active' AND (paycode IS NULL OR paycode = '' OR paycode = 'N/A')");
    if (students.length > 0 && students[0].values.length > 0) {
      for (const row of students[0].values) {
        const code = 'P' + crypto.randomBytes(3).toString('hex').toUpperCase() + Date.now().toString(36).slice(-2).toUpperCase();
        db.run("UPDATE students SET paycode = ? WHERE id = ?", [code, row[0]]);
      }
      saveDb();
      return { success: true, data: { count: students[0].values.length } };
    }
    return { success: true, data: { count: 0 } };
  } catch (e) { return { success: false, error: e.message }; }
});


// ==================== ENHANCED LICENSE VALIDATION ====================
ipcMain.handle('validateLicenseKey', async (e, licenseData) => {
  try {
    if (!licenseData || !licenseData.licenseKey) {
      return { valid: false, error: 'No license key provided' };
    }
    
    const hwid = generateHWID();
    const key = licenseData.licenseKey.trim();
    
    // License format: SSEWASSWA-XXXX-XXXX-XXXX-HWIDHASH
    const parts = key.split('-');
    if (parts.length < 5 || parts[0] !== 'SSEWASSWA') {
      return { valid: false, error: 'Invalid license format' };
    }
    
    // Extract HWID hash from license (last part, first 16 chars)
    const licenseHwidHash = parts[4].substring(0, 16);
    const currentHwidHash = crypto.createHash('sha256').update(hwid).digest('hex').substring(0, 16);
    
    if (licenseHwidHash !== currentHwidHash) {
      return { valid: false, error: 'License not bound to this computer. Contact support.' };
    }
    
    // Store validated license
    db.run("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('license_key', ?)", [key]);
    db.run("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('license_hwid', ?)", [hwid]);
    saveDb();
    
    return { valid: true, message: 'License activated successfully' };
  } catch (err) {
    return { valid: false, error: err.message };
  }
});

// Generate license for a specific HWID (admin use only)
ipcMain.handle('generateLicenseForHwid', async (e, hwid) => {
  try {
    const hwidHash = crypto.createHash('sha256').update(hwid || generateHWID()).digest('hex').substring(0, 16);
    const seg1 = crypto.randomBytes(2).toString('hex').toUpperCase();
    const seg2 = crypto.randomBytes(2).toString('hex').toUpperCase();
    const seg3 = crypto.randomBytes(2).toString('hex').toUpperCase();
    const licenseKey = 'SSEWASSWA-' + seg1 + '-' + seg2 + '-' + seg3 + '-' + hwidHash + crypto.randomBytes(4).toString('hex').toUpperCase();
    return { success: true, licenseKey: licenseKey, hwid: hwid || generateHWID() };
  } catch (err) {
    return { success: false, error: err.message };
  }
});