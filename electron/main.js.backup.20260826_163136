// Generic query
ipcMain.handle('queryDatabase', async (e, query, params = []) => {
  if (!db) return { success: false, error: 'Database not ready', data: [] };
  try {
    const stmt = db.prepare(query); stmt.bind(params || []); const rows = [];
    while (stmt.step()) rows.push(stmt.getAsObject()); stmt.free();
    let lastId = null;
    if (query.trim().toUpperCase().startsWith('INSERT')) { try { const r = db.exec('SELECT last_insert_rowid()'); if (r.length > 0) lastId = r[0].values[0][0]; } catch (e) { } }
    

    // [AUTO-SAVE PATCH] Persist to disk after every write (INSERT/UPDATE/DELETE/CREATE)
    if (/^(INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|REPLACE)\s/i.test(query)) {
      saveDb();
    }return { success: true, data: rows, lastInsertRowid: lastId };
  } catch (err) { return { success: false, error: err.message, data: [] }; }
});

