}

function generateHWID() {
  try {
    const nis = os.networkInterfaces(); let mac = '00-00-00-00-00-00';
    for (const name in nis) { for (const iface of nis[name]) { if (!iface.internal && iface.mac !== '00:00:00:00:00:00') { mac = iface.mac; break; } } if (mac !== '00-00-00-00-00-00') break; }
    return crypto.createHash('sha256').update(mac + os.hostname() + (os.cpus()[0]?.model || '')).digest('hex');
  } catch (e) { return 'UNKNOWN_' + Date.now(); }
}

function q2o(result) {
  if (!result || result.length === 0) return [];
  return result[0].values.map(row => { const obj = {}; result[0].columns.forEach((col, i) => obj[col] = row[i]); return obj; });
}

