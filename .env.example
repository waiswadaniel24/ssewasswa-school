# Ssewasswa School provider configuration
# Copy to .env.local for local testing. Keep real values in deployment secrets.
VITE_BACKEND_PROVIDER=auto

# Primary provider (optional when using Neon)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Neon fallback: use VITE_NEON_URL, or provide both separate endpoints.
VITE_NEON_URL=
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Public URL of an authenticated Cloudflare Worker that fronts R2.
VITE_CLOUDFLARE_STORAGE_URL=
