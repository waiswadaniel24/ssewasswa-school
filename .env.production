# Production environment - Ssewasswa School ERP V10
# Standalone mode with local encryption

# Security flags
VITE_SECURE_MODE=true
VITE_PRODUCTION=true
VITE_DISABLE_DEVTOOLS=true

# Database encryption (set server-side only)
VITE_DB_ENCRYPTION_ENABLED=true

# Session security
VITE_SESSION_TIMEOUT=1800000
VITE_REFRESH_TOKEN_ROTATION=true

# Logging
VITE_LOG_LEVEL=error

# Provider routing (set per deployment; never commit credentials)
# auto = Supabase when configured, otherwise Neon; neon = force Neon for failover
VITE_BACKEND_PROVIDER=auto

# Supabase primary/fallback credentials are supplied by the hosting provider
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Neon Managed Better Auth + Data API (use either VITE_NEON_URL or both endpoint URLs)
# VITE_NEON_URL=
# VITE_NEON_AUTH_URL=
# VITE_NEON_DATA_API_URL=

# Browser-safe URL for an authenticated Cloudflare Worker that fronts R2.
# Never put an R2 access key, secret, or S3 token in a VITE_ variable.
# VITE_CLOUDFLARE_STORAGE_URL=
